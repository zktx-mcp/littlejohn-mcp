{
  "name": "littlejohn-mcp",
  "version": "0.1.0",
  "license": "MIT",
  "mcpName": "io.github.stelis-dev/littlejohn-mcp",
  "description": "Local Robinhood Chain MCP and transaction review runtime.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stelis-dev/littlejohn-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/stelis-dev/littlejohn-mcp/issues"
  },
  "homepage": "https://zktx.io/",
  "type": "module",
  "exports": {},
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "littlejohn": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "LICENSES"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.mcp-app.json --noEmit && vite build --config vite.mcp-app.config.ts",
    "lint": "eslint \"src/interfaces/mcp-app/**/*.ts\" \"test/interfaces/mcp-app/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.mcp-app.json --noEmit && tsc -p tsconfig.mcp-app-test.json --noEmit",
    "test": "vitest run",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "2.2.0",
    "@uniswap/sdk-core": "7.19.0",
    "@uniswap/v2-sdk": "4.21.1",
    "@walletconnect/sign-client": "2.23.10",
    "better-sqlite3": "12.11.1",
    "qrcode": "1.5.4",
    "viem": "2.55.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@testing-library/dom": "10.4.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.1",
    "@typescript-eslint/parser": "8.65.0",
    "ajv": "8.20.0",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "jsdom": "28.1.0",
    "lightweight-charts": "5.2.1",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
