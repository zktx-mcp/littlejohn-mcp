{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/mcp-app-build-policy.ts",
    "vite.mcp-app.config.ts"
  ],
  "exclude": [
    "src/interfaces/mcp-app/view/**/*.ts",
    "test/interfaces/exchange-flow.test.ts",
    "test/interfaces/mcp-app/trade-history-chart.test.ts",
    "test/interfaces/mcp-app/operation-lifecycle.test.ts",
    "test/interfaces/mcp-app/renderers.test.ts",
    "test/interfaces/mcp-app/main.test.ts",
    "test/interfaces/mcp-app/transaction-lifecycle.test.ts",
    "test/interfaces/mcp-app/signing-lifecycle.test.ts"
  ]
}
